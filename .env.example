# Server Configuration
PROJECT_NAME="VÕ E-Commerce API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Security
SECRET_KEY="super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# CẤU HÌNH DATABASE MICROSOFT SQL SERVER
# ==========================================
# Cách 1: Sử dụng tài khoản sa và mật khẩu (Khuyên dùng)
# DATABASE_URL="mssql+pyodbc://sa:YourPassword123@localhost:1433/VoEcommerceDB?driver=ODBC+Driver+17+for+SQL+Server"

# Cách 2: Sử dụng Windows Authentication (Trusted Connection)
# DATABASE_URL="mssql+pyodbc://@localhost/VoEcommerceDB?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes"

# Mặc định đang tạm fallback SQLite để bạn chạy thử nghiệm ngay:
DATABASE_URL="sqlite:///./vo_ecommerce_dev.db"

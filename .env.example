# Server Configuration
PROJECT_NAME="VÕ - Website Võ phục Đai Trắng (B2C & B2B)"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
DEBUG=False

# URLs & CORS (Cập nhật URL Vercel thực tế khi deploy)
FRONTEND_URL="https://your-frontend-app.vercel.app"
BACKEND_URL="https://your-backend-app.up.railway.app"
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://your-frontend-app.vercel.app"]
BACKEND_CORS_ORIGIN_REGEX="https://.*\\.vercel\\.app"

# Security (JWT & Hash)
# BẮT BUỘC đổi: khi DEBUG=False, server từ chối khởi động nếu còn giá trị mẫu này hoặc ngắn hơn 32 ký tự.
# Tạo khóa: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="super-secret-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ==========================================
# CẤU HÌNH DATABASE MONGODB ATLAS
# ==========================================
# Điền chuỗi kết nối từ cụm MongoDB Atlas của bạn:
# Ví dụ: MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority&appName=VoPhucAtlas"
MONGODB_URI="mongodb+srv://admin:YourPasswordHere@cluster0.mongodb.net/?retryWrites=true&w=majority&appName=VoPhucAtlas"
MONGODB_DB_NAME="vo_ecommerce_atlas"


# Server Configuration
PROJECT_NAME="VÕ E-Commerce API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Security
SECRET_KEY="super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default SQLite for dev/demo, can switch to PostgreSQL)
DATABASE_URL="sqlite:///./vo_ecommerce.db"
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/vo_ecommerce"
